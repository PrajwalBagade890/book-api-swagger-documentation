{
  "openapi": "3.0.1",
  "info": {
    "title": "Book API",
    "description": "REST API for managing books. All /api/books endpoints require an API key.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development server"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/api/books": {
      "get": {
        "tags": [
          "Book API"
        ],
        "summary": "Get all books",
        "description": "Returns the complete list of books.",
        "responses": {
          "200": {
            "description": "Books returned successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Book"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Book API"
        ],
        "summary": "Create a book",
        "description": "Adds a new book and returns the created record.",
        "requestBody": {
          "description": "Book details to create",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Book created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "400": {
            "description": "Invalid book details"
          }
        }
      }
    },
    "/api/books/{id}": {
      "get": {
        "tags": [
          "Book API"
        ],
        "summary": "Get book by ID",
        "description": "Finds and returns one book using its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the book to retrieve",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Book found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Book not found"
          }
        }
      },
      "put": {
        "tags": [
          "Book API"
        ],
        "summary": "Update a book",
        "description": "Updates the book matching the supplied ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the book to update",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "requestBody": {
          "description": "Updated book details",
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Book updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Book"
                }
              }
            }
          },
          "404": {
            "description": "Book not found"
          }
        }
      },
      "delete": {
        "tags": [
          "Book API"
        ],
        "summary": "Delete a book",
        "description": "Deletes the book matching the supplied ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "ID of the book to delete",
            "schema": {
              "type": "integer",
              "format": "int64",
              "example": 1
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Book deleted"
          },
          "404": {
            "description": "Book not found"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-KEY"
      }
    },
    "schemas": {
      "Book": {
        "type": "object",
        "description": "Book information returned by the Book API",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique book ID",
            "example": 1
          },
          "title": {
            "type": "string",
            "description": "Book title",
            "example": "Clean Code"
          },
          "author": {
            "type": "string",
            "description": "Book author",
            "example": "Robert C. Martin"
          },
          "price": {
            "type": "number",
            "format": "double",
            "description": "Book price",
            "example": 499.0
          }
        }
      },
      "BookRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "The Pragmatic Programmer"
          },
          "author": {
            "type": "string",
            "example": "Andrew Hunt"
          },
          "price": {
            "type": "number",
            "format": "double",
            "example": 450.0
          }
        },
        "required": [
          "title",
          "author"
        ]
      }
    }
  }
}